#include <winres.h>
1 ICON "nuiter.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NUITER_VERSION_COMMAS
 PRODUCTVERSION NUITER_VERSION_COMMAS
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nuiter contributors"
            VALUE "FileDescription", "Nuiter"
            VALUE "FileVersion", NUITER_VERSION_TEXT
            VALUE "InternalName", "Nuiter"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Nuiter.exe"
            VALUE "ProductName", "Nuiter"
            VALUE "ProductVersion", NUITER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
